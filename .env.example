# ==============================================================================
# NarraView Vega TV Client & Deployment Environment Configuration
# ==============================================================================
# Copy this file to .env.development or .env.production for local development.
# DO NOT commit real credentials, private keys, or admin tokens to version control.

# [REQUIRED] API Base URL for NarraView AWS Backend (API Gateway stage endpoint)
API_BASE_URL=https://YOUR_API_ID.execute-api.eu-north-1.amazonaws.com/prod
NARRAVIEW_API_BASE_URL=https://YOUR_API_ID.execute-api.eu-north-1.amazonaws.com/prod

# [REQUIRED] AWS Region for backend services and AI inference
AWS_REGION=eu-north-1
NARRAVIEW_AWS_REGION=eu-north-1

# [OPTIONAL] Default Viewer ID for deterministic evaluation and testing
NARRAVIEW_DEMO_VIEWER_ID=narraview-demo-viewer

# [OPTIONAL] Admin Token for privileged management and test orchestration
# Configure this in CDK environment or deployment pipeline for backend administration
NARRAVIEW_ADMIN_TOKEN=replace_with_secure_admin_token
ADMIN_TOKEN=replace_with_secure_admin_token

# [OPTIONAL] Amazon Bedrock Mantle LLM Gateway Configuration
BEDROCK_MANTLE_BASE_URL=https://bedrock-mantle.eu-north-1.api.aws/v1
BEDROCK_MANTLE_MODEL=openai.gpt-oss-120b
