# ==============================================================================
# NarraView Studio (Control Plane) Environment Configuration
# ==============================================================================
# Copy this file to studio/.env.local for running NarraView Studio locally.

# [REQUIRED] Public API Gateway base URL for NarraView AWS backend
NEXT_PUBLIC_NARRAVIEW_API_BASE_URL=https://YOUR_API_ID.execute-api.eu-north-1.amazonaws.com/prod

# [REQUIRED] Admin Token for server-side Studio proxy operations (/api/admin)
# Kept strictly server-side in Node.js runtime and never exposed in browser bundles.
NARRAVIEW_ADMIN_TOKEN=replace_with_secure_admin_token
