import React, { useState } from 'react';
import { HomeScreen } from './screens/HomeScreen';
import { DetailsScreen } from './screens/DetailsScreen';
import { PlayerScreen } from './screens/PlayerScreen';
import { LandingScreen } from './screens/LandingScreen';
import { ContentItem } from './types/content';

type Route = 'Landing' | 'Home' | 'Details' | 'Player';

export const App = () => {
  const [route, setRoute] = useState<Route>('Home');
  const [selectedItem, setSelectedItem] = useState<ContentItem | null>(null);

  const handleSelectItem = (item: ContentItem) => {
    setSelectedItem(item);
    setRoute('Details');
  };

  const renderScreen = () => {
    switch (route) {
      case 'Landing':
        return <LandingScreen onEnter={() => setRoute('Home')} />;
      case 'Home':
        return <HomeScreen onSelectItem={handleSelectItem} />;
      case 'Details':
        return selectedItem ? (
          <DetailsScreen 
            item={selectedItem} 
            onWatch={() => setRoute('Player')}
          />
        ) : (
          <HomeScreen onSelectItem={handleSelectItem} />
        );
      case 'Player':
        return selectedItem ? (
          <PlayerScreen 
            item={selectedItem} 
            onExit={() => setRoute('Details')}
          />
        ) : (
          <HomeScreen onSelectItem={handleSelectItem} />
        );
      default:
        return <HomeScreen onSelectItem={handleSelectItem} />;
    }
  };

  return renderScreen();
};

export default App;
